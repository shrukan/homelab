# ---- Required: docker compose stops with a message if one of these is missing

# User and group the containers run as and the config folders belong to
PUID=1000
PGID=1000

# Root media directory
MEDIA_ROOT=/path/to/media

# Root for incomplete downloads
INCOMPLETE_DOWNLOAD_ROOT=/path/to/incomplete/download

# Docker appdata (configuration) directory
APPDATA_ROOT=/path/to/appdata

# ---- Optional: uncomment to change; the value shown is the default

# Timezone
#TZ=Etc/UTC

# Plex: claim token for the first start only, from https://plex.tv/claim
#PLEX_CLAIM_TOKEN=

# Arr stack: API keys for umlautadaptarr, found in each app's settings after
# its first start
#SONARR_API_KEY=
#RADARR_API_KEY=
#RADARR4k_API_KEY=

# Published ports
#ABS_PORT=13378
#SABNZBD_PORT=8080
#SONARR_PORT=8989
#RADARR_PORT=7878
#RADARR4k_PORT=7879
#PROWLARR_PORT=9696
#SEERR_PORT=5055
#TAUTULLI_PORT=8181
#REQUESTRR_PORT=4545
#PROFILARR_PORT=6868
#UMLAUTADAPTARR_PORT=5006

# Backup
# Destination for restic. Any repository URL works, e.g. a local disk
# (/mnt/backup/homelab), SFTP (sftp:user@host:/backup), object storage
# (b2:bucket:path) or an rclone remote (rclone:remote:path).
RESTIC_REPOSITORY=/path/to/backup/repository
# File holding the repository password. Keep it outside the repo, chmod 600.
# Losing this file means losing the backup, it cannot be recovered.
RESTIC_PASSWORD_FILE=/path/to/restic-password
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
